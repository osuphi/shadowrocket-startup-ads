[Body Rewrite]
# 哔哩哔哩
http-response-jq ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?|$) 'if type == "object" then if (.data | type) == "object" then .data |= with_entries(if (.key == "show" or .key == "event_list" or .key == "list") and (.value | type) == "array" then .value = [] else . end) else . end else . end'
# 瑞幸咖啡
http-response-jq ^https?://capi\.lkcoffee\.com/resource/m/sys/app/adposNew(?:\?|$) 'if type == "object" then {status:"SUCCESS"} else . end'
# 知乎
http-response-jq ^https?://api\.zhihu\.com/commercial_api/(?:launch_v2|real_time_launch_v2)(?:\?|$) 'def clean: if type == "array" then map(clean) elif type == "object" then with_entries(.value |= clean) | (if has("img_play_duration") and (.img_play_duration | type) == "number" then .img_play_duration = 0 else . end) | (if has("launch_timeout") and (.launch_timeout | type) == "number" then .launch_timeout = 0 else . end) elif type == "string" and (contains("img_play_duration") or contains("launch_timeout")) then . as $original | try (fromjson | clean | tojson) catch $original else . end; clean'
# 12306
http-response-jq ^https?://ad\.12306\.cn/ad/ser/getAdList(?:\?|$) 'if type == "object" then (if (.materialsList | type) == "array" then .materialsList = [] else . end) | (if (.advertParam | type) == "object" and (.advertParam.skipTime | type) == "number" then .advertParam.skipTime = 0 else . end) else . end'
# 爱奇艺
http-response-jq ^https?://(?:kjp\.cupid\.iqiyi\.com|t7z\.cupid\.iqiyi\.com)/mixer(?:\?|$) 'if type == "object" then if .errorCode == 0 then del(.adSlots, .splashLottieFile, .splashUiConfig) else . end else . end'
# 京东
http-response-jq ^https?://api\.m\.jd\.com/client\.action\?(?:[^#]*&)?functionId=start(?:&|$) 'if type == "object" then (if (.images | type) == "array" then .images = [] else . end) | (if (.showTimesDaily | type) == "number" then .showTimesDaily = 0 else . end) else . end'
# 什么值得买
http-response-jq ^https?://app\-api\.smzdm\.com/util/loading(?:\?|$) 'if type == "object" then del(.data) else . end'
# 淘宝
http-response-jq ^https?://guide\-acs\.m\.taobao\.com/gw/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:/|\?|$) 'def clean: if type == "array" then map(clean) elif type == "object" then with_entries(if .key == "taobao-splash" and (.value | type) == "object" then .value |= (if (.data | type) == "array" then .data = [] else . end) else .value |= clean end) else . end; clean'
# 小红书
http-response-jq ^https?://(?:edith\.rnote\.com|edith\.xiaohongshu\.com)/api/sns/v\d+/system_service/config(?:\?|$) 'if type == "object" then if (.data | type) == "object" then (if (.data.ads_groups | type) == "array" then .data.ads_groups = [] else . end) | del(.data.splash, .data.loading_img) else . end else . end'
# 小红书
http-response-jq ^https?://(?:edith\.rnote\.com|edith\.xiaohongshu\.com)/api/sns/v\d+/system_service/splash_config(?:\?|$) 'if type == "object" then if (.data | type) == "object" then (if (.data.ads_groups | type) == "array" then .data.ads_groups = [] else . end) | del(.data.splash, .data.loading_img) else . end else . end'
# 优酷
http-response-jq ^https?://un\-acs\.youku\.com/gw/mtop\.youku\.play\.ups\.appinfo\.get(?:/|\?|$) 'if type == "object" then if (.data | type) == "object" then if (.data.data | type) == "object" then del(.data.data.ad, .data.data.ykad) else . end else . end else . end'

