[Body Rewrite]
# 哔哩哔哩
http-response-jq ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?|$) 'if (.data | type) == "object" then .data |= with_entries(if (.key == "show" or .key == "event_list" or .key == "list") and (.value | type) == "array" then .value = [] else . end) else . end'
# 知乎
http-response-jq ^https?://api\.zhihu\.com/commercial_api/(?:launch_v2|real_time_launch_v2)(?:\?|$) 'def clean: if type == "array" then map(clean) elif type == "object" then with_entries(.value |= clean) | (if has("img_play_duration") and (.img_play_duration | type) == "number" then .img_play_duration = 0 else . end) | (if has("launch_timeout") and (.launch_timeout | type) == "number" then .launch_timeout = 0 else . end) elif type == "string" and (contains("img_play_duration") or contains("launch_timeout")) then . as $original | try (fromjson | clean | tojson) catch $original else . end; clean'

